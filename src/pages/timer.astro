---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const title = `ダイエット バウンスタイマー | ${SITE_TITLE}`;
const description = '30秒ゆっくり弾む→30〜60秒休憩を5〜10セット繰り返すダイエット用インターバルタイマー';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<h1>バウンスタイマー</h1>
			<p>「30秒ゆっくり弾む → 30〜60秒休憩」を1セットとして、5〜10セット繰り返すダイエット用タイマーです。</p>

			<section class="settings">
				<div class="field">
					<label for="bounce-seconds">運動時間（秒）</label>
					<input type="number" id="bounce-seconds" min="5" max="600" step="5" value="30" />
				</div>
				<div class="field">
					<label for="rest-seconds">休憩時間（秒）</label>
					<input type="number" id="rest-seconds" min="5" max="600" step="5" value="45" />
				</div>
				<div class="field">
					<label for="set-count">セット数</label>
					<input type="number" id="set-count" min="1" max="30" step="1" value="8" />
				</div>
				<div class="field">
					<label for="height-cm">身長（cm）</label>
					<input type="number" id="height-cm" min="100" max="250" step="0.1" placeholder="160" />
				</div>
				<div class="field">
					<label for="weight-kg">体重（kg）</label>
					<input type="number" id="weight-kg" min="20" max="300" step="0.1" placeholder="55" />
				</div>
			</section>
			<p class="calorie-note">
				消費カロリーは体重をもとにMETs法（運動中 約3.5METs、休憩中 約1.3METs）で概算しています。実際の消費量とは誤差があります。
			</p>

			<section class="timer" aria-live="polite">
				<p class="phase" id="phase">スタートを押して開始</p>
				<p class="time" id="time">00:30</p>
				<p class="set-count" id="set-progress">0 / 8 セット</p>
				<p class="calories" id="calories">消費カロリー: 体重を入力してください</p>
			</section>

			<section class="controls">
				<button id="start-btn" type="button">スタート</button>
				<button id="pause-btn" type="button" disabled>一時停止</button>
				<button id="reset-btn" type="button">リセット</button>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.settings {
		display: flex;
		flex-wrap: wrap;
		gap: 1em;
		margin: 1.5em 0;
		padding: 1em;
		background: rgb(var(--gray-light));
		border-radius: 8px;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
	}
	.field label {
		font-size: 0.85em;
		color: rgb(var(--gray-dark));
	}
	.field input {
		width: 6em;
		padding: 0.4em;
		border: 1px solid rgb(var(--gray));
		border-radius: 4px;
	}
	.timer {
		text-align: center;
		margin: 2em 0;
		padding: 2em 1em;
		border-radius: 12px;
		background: white;
		box-shadow: var(--box-shadow);
	}
	.phase {
		font-size: 1.4em;
		font-weight: bold;
		margin: 0 0 0.5em 0;
		color: var(--accent);
	}
	.timer.resting .phase {
		color: rgb(var(--gray-dark));
	}
	.time {
		font-size: 4em;
		font-weight: bold;
		margin: 0 0 0.3em 0;
		font-variant-numeric: tabular-nums;
	}
	.set-count {
		margin: 0;
		color: rgb(var(--gray-dark));
	}
	.calories {
		margin: 0.6em 0 0 0;
		font-size: 1.1em;
		font-weight: bold;
	}
	.calorie-note {
		font-size: 0.8em;
		color: rgb(var(--gray));
		margin: -1em 0 1.5em 0;
	}
	.controls {
		display: flex;
		gap: 1em;
		justify-content: center;
		margin-bottom: 2em;
	}
	.controls button {
		padding: 0.7em 1.5em;
		font-size: 1em;
		border: none;
		border-radius: 6px;
		background: var(--accent);
		color: white;
		cursor: pointer;
	}
	.controls button:hover:not(:disabled) {
		background: var(--accent-dark);
	}
	.controls button:disabled {
		background: rgb(var(--gray));
		cursor: not-allowed;
	}
</style>

<script>
	const bounceInput = document.getElementById('bounce-seconds') as HTMLInputElement;
	const restInput = document.getElementById('rest-seconds') as HTMLInputElement;
	const setInput = document.getElementById('set-count') as HTMLInputElement;
	const heightInput = document.getElementById('height-cm') as HTMLInputElement;
	const weightInput = document.getElementById('weight-kg') as HTMLInputElement;

	const timerSection = document.querySelector('.timer') as HTMLElement;
	const phaseEl = document.getElementById('phase') as HTMLElement;
	const timeEl = document.getElementById('time') as HTMLElement;
	const setProgressEl = document.getElementById('set-progress') as HTMLElement;
	const caloriesEl = document.getElementById('calories') as HTMLElement;

	const startBtn = document.getElementById('start-btn') as HTMLButtonElement;
	const pauseBtn = document.getElementById('pause-btn') as HTMLButtonElement;
	const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;

	type Phase = 'idle' | 'bounce' | 'rest' | 'done';

	// METs (運動強度の目安): トランポリンでゆっくり弾む運動 / 休憩中の起立
	const BOUNCE_MET = 3.5;
	const REST_MET = 1.3;

	let phase: Phase = 'idle';
	let currentSet = 0;
	let secondsLeft = 0;
	let intervalId: number | undefined;
	let audioCtx: AudioContext | undefined;
	let caloriesBurned = 0;

	function totalSets() {
		return Math.max(1, parseInt(setInput.value, 10) || 1);
	}

	function currentWeightKg(): number | undefined {
		const value = parseFloat(weightInput.value);
		return value > 0 ? value : undefined;
	}

	function addElapsedSecondCalories() {
		const weightKg = currentWeightKg();
		if (weightKg === undefined) return;
		const met = phase === 'bounce' ? BOUNCE_MET : phase === 'rest' ? REST_MET : 0;
		caloriesBurned += (met * weightKg) / 3600;
	}

	function updateCaloriesDisplay() {
		const weightKg = currentWeightKg();
		if (weightKg === undefined) {
			caloriesEl.textContent = '消費カロリー: 体重を入力してください';
			return;
		}
		caloriesEl.textContent = `消費カロリー(推定): 約${caloriesBurned.toFixed(1)} kcal`;
	}

	function restoreProfile() {
		try {
			const savedHeight = localStorage.getItem('bounce-timer:height-cm');
			const savedWeight = localStorage.getItem('bounce-timer:weight-kg');
			if (savedHeight) heightInput.value = savedHeight;
			if (savedWeight) weightInput.value = savedWeight;
		} catch {
			// localStorage unavailable; skip restoring saved profile.
		}
	}

	function saveProfile() {
		try {
			localStorage.setItem('bounce-timer:height-cm', heightInput.value);
			localStorage.setItem('bounce-timer:weight-kg', weightInput.value);
		} catch {
			// localStorage unavailable; skip saving profile.
		}
	}

	function formatTime(totalSeconds: number) {
		const m = Math.floor(totalSeconds / 60);
		const s = totalSeconds % 60;
		return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
	}

	function beep(frequency: number, duration: number) {
		try {
			audioCtx ??= new AudioContext();
			const oscillator = audioCtx.createOscillator();
			const gain = audioCtx.createGain();
			oscillator.frequency.value = frequency;
			oscillator.connect(gain);
			gain.connect(audioCtx.destination);
			gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
			gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
			oscillator.start();
			oscillator.stop(audioCtx.currentTime + duration);
		} catch {
			// Web Audio unavailable; skip sound cue.
		}
	}

	function updateDisplay() {
		timeEl.textContent = formatTime(secondsLeft);
		setProgressEl.textContent = `${currentSet} / ${totalSets()} セット`;
		timerSection.classList.toggle('resting', phase === 'rest');
		updateCaloriesDisplay();

		if (phase === 'idle') {
			phaseEl.textContent = 'スタートを押して開始';
		} else if (phase === 'bounce') {
			phaseEl.textContent = 'ゆっくり弾む！';
		} else if (phase === 'rest') {
			phaseEl.textContent = '休憩';
		} else if (phase === 'done') {
			phaseEl.textContent = 'おつかれさまでした！';
		}
	}

	function clearTimer() {
		if (intervalId !== undefined) {
			window.clearInterval(intervalId);
			intervalId = undefined;
		}
	}

	function startPhase(next: Phase) {
		phase = next;
		secondsLeft = next === 'bounce' ? parseInt(bounceInput.value, 10) || 30 : parseInt(restInput.value, 10) || 30;
		beep(next === 'bounce' ? 880 : 440, 0.25);
		updateDisplay();
	}

	function tick() {
		addElapsedSecondCalories();
		secondsLeft -= 1;

		if (secondsLeft > 0) {
			updateDisplay();
			return;
		}

		if (phase === 'bounce') {
			if (currentSet >= totalSets()) {
				finish();
				return;
			}
			startPhase('rest');
		} else if (phase === 'rest') {
			currentSet += 1;
			if (currentSet >= totalSets()) {
				finish();
				return;
			}
			startPhase('bounce');
		}
	}

	function finish() {
		clearTimer();
		phase = 'done';
		currentSet = totalSets();
		secondsLeft = 0;
		beep(660, 0.6);
		updateDisplay();
		startBtn.disabled = false;
		startBtn.textContent = 'もう一度';
		pauseBtn.disabled = true;
		setInputsDisabled(false);
	}

	function setInputsDisabled(disabled: boolean) {
		bounceInput.disabled = disabled;
		restInput.disabled = disabled;
		setInput.disabled = disabled;
		heightInput.disabled = disabled;
		weightInput.disabled = disabled;
	}

	function start() {
		clearTimer();
		setInputsDisabled(true);
		startBtn.disabled = true;
		startBtn.textContent = 'スタート';
		pauseBtn.disabled = false;
		pauseBtn.textContent = '一時停止';
		currentSet = 1;
		caloriesBurned = 0;
		startPhase('bounce');
		intervalId = window.setInterval(tick, 1000);
	}

	function pause() {
		if (intervalId !== undefined) {
			clearTimer();
			pauseBtn.textContent = '再開';
		} else if (phase === 'bounce' || phase === 'rest') {
			intervalId = window.setInterval(tick, 1000);
			pauseBtn.textContent = '一時停止';
		}
	}

	function reset() {
		clearTimer();
		phase = 'idle';
		currentSet = 0;
		caloriesBurned = 0;
		secondsLeft = parseInt(bounceInput.value, 10) || 30;
		updateDisplay();
		startBtn.disabled = false;
		startBtn.textContent = 'スタート';
		pauseBtn.disabled = true;
		pauseBtn.textContent = '一時停止';
		setInputsDisabled(false);
	}

	startBtn.addEventListener('click', start);
	pauseBtn.addEventListener('click', pause);
	resetBtn.addEventListener('click', reset);
	heightInput.addEventListener('change', saveProfile);
	weightInput.addEventListener('change', () => {
		saveProfile();
		updateCaloriesDisplay();
	});

	restoreProfile();
	reset();
</script>
